      <component id="c006f" class="javax.swing.JLabel" binding="lblTituloMarcador"><constraints><grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="MARCADOR"/></properties></component>
      <scrollpane id="c0071" binding="scrollMarcador">
