          <component id="c006c" class="javax.swing.JLabel" binding="lblSecretoIzquierda"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Personaje izquierda"/></properties></component>
          <component id="c006d" class="javax.swing.JLabel" binding="lblSecretoDerecha"><constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Personaje derecha"/></properties></component>
