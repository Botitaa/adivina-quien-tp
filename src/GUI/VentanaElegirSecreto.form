<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="GUI.VentanaElegirSecreto">
  <grid id="c0033" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="7" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints><xy x="20" y="20" width="1000" height="700"/></constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="c0028" class="javax.swing.JLabel" binding="lblTitulo"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="ELEGÍ TU PERSONAJE SECRETO"/></properties></component>
      <component id="c0029" class="javax.swing.JLabel" binding="lblInstruccion"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Instrucción"/></properties></component>
      <vspacer id="c002a"><constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"></grid></constraints></vspacer>
      <grid id="c002b" binding="contenedorTablero" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints><grid row="3" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"></grid></constraints>
        <properties/>
        <border type="etched" title="Tablero de cartas (se completa por código)"/>
        <children/>
      </grid>
      <component id="c002c" class="javax.swing.JLabel" binding="lblSeleccion"><constraints><grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Personaje elegido"/></properties></component>
      <vspacer id="c002d"><constraints><grid row="5" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"></grid></constraints></vspacer>
      <grid id="c0032" binding="panelBotones" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints><grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"></grid></constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="c002e" class="javax.swing.JButton" binding="btnVolver"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Volver"/></properties></component>
          <hspacer id="c002f"><constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"></grid></constraints></hspacer>
          <component id="c0030" class="javax.swing.JButton" binding="btnAlAzar"><constraints><grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Al azar"/></properties></component>
          <component id="c0031" class="javax.swing.JButton" binding="btnConfirmar"><constraints><grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Confirmar"/></properties></component>
        </children>
      </grid>
    </children>
  </grid>
</form>
