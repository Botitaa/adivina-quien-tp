<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="GUI.VentanaJuego">
  <grid id="27dc6" binding="panel1" default-binding="true" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="fd252" class="javax.swing.JButton" binding="btnPreguntar">
        <constraints border-constraint="South"/>
        <properties>
          <text value="Preguntar"/>
        </properties>
      </component>
      <component id="b2f2c" class="javax.swing.JButton" binding="btnAdivinar">
        <constraints border-constraint="Center"/>
        <properties>
          <text value="Adivinar"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
