        <children>
          <component id="c001b" class="javax.swing.JLabel" binding="lblNombre"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Tu nombre"/></properties></component>
          <component id="c001c" class="javax.swing.JTextField" binding="txtNombre"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"></grid></constraints><properties/></component>
          <component id="c001d" class="javax.swing.JLabel" binding="lblRival"><constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Tu rival"/></properties></component>
          <component id="c001e" class="javax.swing.JRadioButton" binding="rbBasica"><constraints><grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Máquina Básica"/></properties></component>
          <component id="c001f" class="javax.swing.JRadioButton" binding="rbAsertiva"><constraints><grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Máquina Asertiva"/></properties></component>
          <component id="c0020" class="javax.swing.JLabel" binding="lblDescripcionRival"><constraints><grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Descripción del rival"/></properties></component>
          <component id="c0021" class="javax.swing.JLabel" binding="lblError"><constraints><grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Mensaje de error"/></properties></component>
