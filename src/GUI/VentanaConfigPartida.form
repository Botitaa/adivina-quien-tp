      <hspacer id="c001a"><constraints><grid row="2" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"></grid></constraints></hspacer>
      <grid id="c0022" binding="panelFormulario" layout-manager="GridLayoutManager" row-count="7" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="8">
