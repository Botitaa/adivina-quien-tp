          <component id="c0006" class="javax.swing.JButton" binding="btnJugar"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Jugar"/></properties></component>
          <component id="c0007" class="javax.swing.JButton" binding="btnMarcador"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Marcador"/></properties></component>
          <component id="c0008" class="javax.swing.JButton" binding="btnSalir"><constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Salir"/></properties></component>
