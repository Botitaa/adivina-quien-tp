<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="GUI.VentanaMenu">
  <grid id="27dc6" binding="menu" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="1280" height="1280"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="f5a37" class="javax.swing.JLabel" binding="Titulo">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties>
          <enabled value="true"/>
          <font/>
          <horizontalAlignment value="0"/>
          <horizontalTextPosition value="0"/>
          <text value="Adivina Quien!"/>
        </properties>
      </component>
      <grid id="74c6b" binding="panelBtn" layout-manager="GridBagLayout">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="8c0c0" class="javax.swing.JButton" binding="btnEspectador">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Modo Espectador"/>
            </properties>
          </component>
          <component id="17ff3" class="javax.swing.JButton" binding="btnJugar">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Jugar"/>
            </properties>
          </component>
          <component id="b1bc" class="javax.swing.JButton" binding="btnSalir">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Salir"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
