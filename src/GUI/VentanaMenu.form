      <component id="c0002" class="javax.swing.JLabel" binding="lblTitulo"><constraints><grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="ADIVINA QUIÉN"/></properties></component>
      <component id="c0003" class="javax.swing.JLabel" binding="lblPortada"><constraints><grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"></grid></constraints><properties><text value="Imagen de portada"/></properties></component>
