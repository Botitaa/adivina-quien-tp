<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="GUI.VentanaMenu">
  <grid id="c000b" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="5" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="12">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints><xy x="20" y="20" width="1000" height="700"/></constraints>
    <properties/>
